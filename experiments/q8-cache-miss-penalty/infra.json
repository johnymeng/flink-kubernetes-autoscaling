      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "OWNER-flink",
        "namespace": "a4s-bench-ryan-q8",
        "labels": {
          "ece496-benchmark-owner": "OWNER"
        }
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "OWNER-flink"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "OWNER-flink",
          "namespace": "a4s-bench-ryan-q8"
        }
      ]
    }
  ]
