+
+TEST_F(LRUCacheTest, A4SLookupCountsGhostMissAndIgnoresHistogramReset) {
+  NewCache(3, 0.0, kDefaultToAdaptiveMutex, true);
+  Insert("a");
+  Insert("b");
+  Insert("c");
+  ASSERT_TRUE(Lookup("a"));
+  Insert("d");  // evicts "b", but the ghost index remembers it.
+  ASSERT_FALSE(Lookup("b"));
+  ASSERT_FALSE(Lookup("unknown"));
+
+  // Only "unknown" is a QuickMRC complete miss.
+  ASSERT_EQ(1U, cache_->GetQuickMRCCompleteMissCount());
+  A4SCacheLookupSnapshot snapshot;
+  ASSERT_TRUE(cache_->GetA4SCacheLookupCounters(&snapshot));
+  ASSERT_EQ(3U, snapshot.capacity_bytes);
+  ASSERT_EQ(3U, snapshot.lookups);
+  ASSERT_EQ(2U, snapshot.resident_misses);
+  const uint64_t original_generation = snapshot.capacity_generation;
+
+  cache_->ResetQuickMRCStats();
+  ASSERT_EQ(0U, cache_->GetQuickMRCCompleteMissCount());
+  ASSERT_TRUE(cache_->GetA4SCacheLookupCounters(&snapshot));
+  ASSERT_EQ(3U, snapshot.lookups);
+  ASSERT_EQ(2U, snapshot.resident_misses);
+  ASSERT_EQ(original_generation, snapshot.capacity_generation);
+
+  // A resize round-trip invalidates cross-boundary intervals even when the
+  // configured capacity equals its old value again.
+  cache_->SetCapacity(5);
+  cache_->SetCapacity(3);
+  cache_->SetCapacity(3);
+  ASSERT_TRUE(cache_->GetA4SCacheLookupCounters(&snapshot));
+  ASSERT_EQ(3U, snapshot.capacity_bytes);
+  ASSERT_EQ(original_generation + 2, snapshot.capacity_generation);
+  ASSERT_EQ(3U, snapshot.lookups);
+  ASSERT_EQ(2U, snapshot.resident_misses);
+}
+
+TEST_F(LRUCacheTest, A4SLookupSnapshotsAreCoherentDuringLookups) {
+  NewCache(3, 0.0, kDefaultToAdaptiveMutex, true);
+  constexpr uint64_t count = 4096;
+  std::atomic<bool> done{false};
+  std::thread writer([&] {
+    for (uint64_t i = 0; i < count; ++i) {
+      cache_->Lookup("always-absent", 0 /*hash*/);
+    }
+    done.store(true, std::memory_order_release);
+  });
+
+  uint64_t last = 0;
+  do {
+    A4SCacheLookupSnapshot snapshot;
+    EXPECT_TRUE(cache_->GetA4SCacheLookupCounters(&snapshot));
+    EXPECT_EQ(snapshot.lookups, snapshot.resident_misses);
+    EXPECT_GE(snapshot.lookups, last);
+    last = snapshot.lookups;
+  } while (!done.load(std::memory_order_acquire));
+
+  writer.join();
+  A4SCacheLookupSnapshot last_snapshot;
+  ASSERT_TRUE(cache_->GetA4SCacheLookupCounters(&last_snapshot));
+  ASSERT_EQ(count, last_snapshot.lookups);
+  ASSERT_EQ(count, last_snapshot.resident_misses);
+}
