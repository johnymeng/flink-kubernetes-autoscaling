+jlongArray Java_org_rocksdb_LRUCache_getA4SCacheLookupSnapshot(
+    JNIEnv* env, jclass /*jcls*/, jlong jhandle) {
+  auto* sptr_lru_cache =
+      reinterpret_cast<std::shared_ptr<ROCKSDB_NAMESPACE::Cache>*>(jhandle);
+  auto* cache =
+      static_cast<ROCKSDB_NAMESPACE::LRUCache*>(sptr_lru_cache->get());
+  ROCKSDB_NAMESPACE::A4SCacheLookupSnapshot snapshot;
+  if (cache == nullptr || !cache->GetA4SCacheLookupSnapshot(&snapshot)) {
+    return nullptr;
+  }
+
+  const uint64_t values[] = {1,
+                             snapshot.cache_id,
+                             snapshot.capacity_bytes,
+                             snapshot.capacity_generation,
+                             snapshot.shard_count,
+                             snapshot.lookups,
+                             snapshot.resident_misses};
+  constexpr jsize length = sizeof(values) / sizeof(values[0]);
+  jlong java_values[length];
+  for (jsize i = 0; i < length; ++i) {
+    if (values[i] > static_cast<uint64_t>(std::numeric_limits<jlong>::max())) {
+      return nullptr;
+    }
+    java_values[i] = static_cast<jlong>(values[i]);
+  }
+  auto result = env->NewLongArray(length);
+  if (result != nullptr) {
+    env->SetLongArrayRegion(result, 0, length, java_values);
+  }
+  return result;
+}
