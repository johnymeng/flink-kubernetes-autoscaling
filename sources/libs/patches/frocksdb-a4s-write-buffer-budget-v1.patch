@@ -27,6 +27,25 @@
     super(newWriteBufferManager(bufferSizeBytes, cache.nativeHandle_));
   }

+  /**
+   * Reads the current native write-buffer budget in bytes (capacity readback ABI 1).
+   *
+   * @throws IllegalStateException if this manager has been closed
+   */
+  public synchronized long getBufferSizeBytesV1() {
+    if (!isOwningHandle()) {
+      throw new IllegalStateException("WriteBufferManager is closed");
+    }
+    return getBufferSizeBytesNativeV1(nativeHandle_);
+  }
+
+  @Override
+  public synchronized void close() {
+    super.close();
+  }
+
+  private static native long getBufferSizeBytesNativeV1(final long handle);
+
   private native static long newWriteBufferManager(final long bufferSizeBytes, final long cacheHandle);
   @Override
   protected native void disposeInternal(final long handle);
