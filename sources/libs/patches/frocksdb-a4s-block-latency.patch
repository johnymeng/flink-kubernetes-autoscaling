+bool SampleA4SDataBlockLatency(Statistics* statistics) {
+  static const bool enabled = [] {
+    const char* value = std::getenv("FLINK_A4S_SAMPLE_BLOCK_LATENCY");
+    return value != nullptr && std::strcmp(value, "1") == 0;
+  }();
+  if (!enabled || statistics == nullptr) {
+    return false;
+  }
+  thread_local Random sampler(static_cast<uint32_t>(
+      std::hash<std::thread::id>{}(std::this_thread::get_id())));
+  return sampler.OneIn(128);
+}
