<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.a4s</groupId>
    <artifactId>a4s-parent</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>a4s-runner</artifactId>
  <dependencies>
    <dependency>
      <groupId>io.a4s</groupId>
      <artifactId>a4s-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.a4s</groupId>
      <artifactId>a4s-http</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <finalName>a4s-runner</finalName>
    <plugins><plugin>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-shade-plugin</artifactId>
      <version>3.4.1</version>
      <executions><execution>
        <phase>package</phase>
        <goals><goal>shade</goal></goals>
        <configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <filters>
            <filter>
              <artifact>*:*</artifact>
              <excludes>
                <exclude>module-info.class</exclude>
                <exclude>META-INF/versions/**/module-info.class</exclude>
              </excludes>
            </filter>
          </filters>
          <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
            <mainClass>io.a4s.runner.Main</mainClass>
          </transformer></transformers>
        </configuration>
      </execution></executions>
    </plugin></plugins>
  </build>
</project>
